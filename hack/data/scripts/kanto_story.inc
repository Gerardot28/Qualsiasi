@ shared wild legendary / obstacle battle: setwildbattle done by the caller, VAR_0x8004 = species (for the cry)
KantoStory_EventScript_StaticBattle::
	waitse
	playmoncry VAR_0x8004, CRY_MODE_ENCOUNTER
	delay 40
	waitmoncry
	dowildbattle
	release
	end

KantoTaxi_EventScript_Taxi::
	lock
	faceplayer
	msgbox KantoTaxi_Text_Intro, MSGBOX_DEFAULT
	call_if_set FLAG_KANTO_VISITED_PALLET, KantoTaxi_EventScript_PushPallet
	call_if_set FLAG_KANTO_VISITED_VIRIDIAN, KantoTaxi_EventScript_PushViridian
	call_if_set FLAG_KANTO_VISITED_PEWTER, KantoTaxi_EventScript_PushPewter
	call_if_set FLAG_KANTO_VISITED_CERULEAN, KantoTaxi_EventScript_PushCerulean
	call_if_set FLAG_KANTO_VISITED_VERMILION, KantoTaxi_EventScript_PushVermilion
	call_if_set FLAG_KANTO_VISITED_LAVENDER, KantoTaxi_EventScript_PushLavender
	call_if_set FLAG_KANTO_VISITED_CELADON, KantoTaxi_EventScript_PushCeladon
	call_if_set FLAG_KANTO_VISITED_FUCHSIA, KantoTaxi_EventScript_PushFuchsia
	call_if_set FLAG_KANTO_VISITED_SAFFRON, KantoTaxi_EventScript_PushSaffron
	call_if_set FLAG_KANTO_VISITED_CINNABAR, KantoTaxi_EventScript_PushCinnabar
	call_if_set FLAG_KANTO_VISITED_INDIGO, KantoTaxi_EventScript_PushIndigo
	dynmultipush KantoTaxi_Text_Cancel, 127
	dynmultistack 0, 0, FALSE, 6, FALSE, 0, DYN_MULTICHOICE_CB_NONE
	switch VAR_RESULT
	case 0, KantoTaxi_EventScript_ToPallet
	case 1, KantoTaxi_EventScript_ToViridian
	case 2, KantoTaxi_EventScript_ToPewter
	case 3, KantoTaxi_EventScript_ToCerulean
	case 4, KantoTaxi_EventScript_ToVermilion
	case 5, KantoTaxi_EventScript_ToLavender
	case 6, KantoTaxi_EventScript_ToCeladon
	case 7, KantoTaxi_EventScript_ToFuchsia
	case 8, KantoTaxi_EventScript_ToSaffron
	case 9, KantoTaxi_EventScript_ToCinnabar
	case 10, KantoTaxi_EventScript_ToIndigo
	msgbox KantoTaxi_Text_Bye, MSGBOX_DEFAULT
	release
	end

KantoTaxi_EventScript_PushPallet::
	dynmultipush KantoTaxi_Text_TownPallet, 0
	return


@ Pokemon Mansion switches: copy of data/scripts/pokemon_mansion.inc, saved flag FLAG_KANTO_MANSION_SWITCH
KantoMansion_EventScript_SecretSwitch::
	msgbox KantoMansion_Text_PressSecretSwitch, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, NO, KantoMansion_EventScript_DontPressSwitch
	msgbox KantoMansion_Text_WhoWouldnt
	goto_if_set FLAG_KANTO_MANSION_SWITCH, KantoMansion_EventScript_ResetSwitch
	setflag FLAG_KANTO_MANSION_SWITCH
	switch VAR_0x8004
	case 0, KantoMansion_EventScript_PressSwitch_1F
	case 1, KantoMansion_EventScript_PressSwitch_2F
	case 2, KantoMansion_EventScript_PressSwitch_3F
	case 3, KantoMansion_EventScript_PressSwitch_B1F
	end

KantoMansion_EventScript_ResetSwitch::
	clearflag FLAG_KANTO_MANSION_SWITCH
	switch VAR_0x8004
	case 0, KantoMansion_EventScript_ResetSwitch_1F
	case 1, KantoMansion_EventScript_ResetSwitch_2F
	case 2, KantoMansion_EventScript_ResetSwitch_3F
	case 3, KantoMansion_EventScript_ResetSwitch_B1F
	end

KantoMansion_EventScript_DontPressSwitch::
	msgbox KantoMansion_Text_NotQuiteYet
	releaseall
	end


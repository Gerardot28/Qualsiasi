DewfordTown_EventScript_TrendyPhraseBoy::
	lock
	faceplayer
	call Common_EventScript_BufferTrendyPhrase
	msgbox DewfordTown_Text_XIsTheBiggestHappeningThingRight, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, YES, DewfordTown_EventScript_ConfirmTrendyPhrase
	goto_if_eq VAR_RESULT, NO, DewfordTown_EventScript_RejectTrendyPhrase
	end

DewfordTown_EventScript_ConfirmTrendyPhrase::
	msgbox DewfordTown_Text_YeahDefinitionOfInRightNow, MSGBOX_DEFAULT
	release
	end

DewfordTown_EventScript_RejectTrendyPhrase::
	msgbox DewfordTown_Text_TellMeWhatsNewAndIn, MSGBOX_DEFAULT
	setvar VAR_0x8004, EASY_CHAT_TYPE_TRENDY_PHRASE
	call Common_ShowEasyChatScreen
	lock
	faceplayer
	goto_if_eq VAR_RESULT, TRUE, DewfordTown_EventScript_GiveNewTrendyPhrase
	goto_if_eq VAR_RESULT, FALSE, DewfordTown_EventScript_CancelNewTrendyPhrase
	end

DewfordTown_EventScript_GiveNewTrendyPhrase::
	incrementgamestat GAME_STAT_STARTED_TRENDS
	goto_if_eq VAR_0x8004, FALSE, DewfordTown_EventScript_PhraseNotTrendyEnough
	msgbox DewfordTown_Text_OfCourseIKnowAboutThat, MSGBOX_DEFAULT
	release
	end

DewfordTown_EventScript_CancelNewTrendyPhrase::
	msgbox DewfordTown_Text_HearOfAnyTrendsComeShareWithMe, MSGBOX_DEFAULT
	release
	end

DewfordTown_EventScript_PhraseNotTrendyEnough::
	msgbox DewfordTown_Text_XHuhIThinkYIsCool, MSGBOX_DEFAULT
	release
	end

DewfordTown_Text_TinyIslandCommunity:
	.string "Bluruvia è una piccola comunità isolana.\n"
	.string "Quando qualcosa va di moda qui,\l"
	.string "lo sanno tutti in un battibaleno.$"

DewfordTown_Text_TownSign:
	.string "Bluruvia\n"
	.string "“Un'isoletta nel mare blu.”$"

DewfordTown_Text_GymSign:
	.string "Palestra Pokémon di Bluruvia\n"
	.string "Capopalestra: Rudi\l"
	.string "“Un'onda travolgente di Lotta!”$"

DewfordTown_Text_HallSign:
	.string "Salone di Bluruvia\n"
	.string "“Notizie fresche per tutti!”$"

Route104_Text_LandedInDewfordDeliverLetter:
	.string "Capitan Scoglio: Ahoy!\n"
	.string "Siamo approdati a Bluruvia.\p"
	.string "Immagino che tu debba consegnare\n"
	.string "quella Lettera a… come si chiamava…\l"
	.string "ah, sì, Rocco!$"

DewfordTown_Text_SetSailBackToPetalburg:
	.string "Capitan Scoglio: Hai consegnato la\n"
	.string "tua Lettera?\p"
	.string "O volevi tornare per mare a\n"
	.string "Petalipoli?$"

DewfordTown_Text_PetalburgWereSettingSail2:
	.string "Capitan Scoglio: Petalipoli, allora!\p"
	.string "Mollate gli ormeggi!\n"
	.string "Peeko, si salpa, tesoro mio!$"

DewfordTown_Text_GoDeliverIllBeWaiting:
	.string "Capitan Scoglio: Allora va' pure a\n"
	.string "consegnare la Lettera. Ti aspetto qui.$"

DewfordTown_Text_BrineyLandedInDewford:
	.string "Capitan Scoglio: Ahoy!\n"
	.string "Siamo approdati a Bluruvia!\p"
	.string "Quando vuoi salpare di nuovo,\n"
	.string "basta che me lo dici!$"

DewfordTown_Text_WhereAreWeBound:
	.string "Capitan Scoglio: Ahoy!\n"
	.string "Per te prendo il mare quando vuoi!\p"
	.string "Allora, amico mio, dove si va?$"

DewfordTown_Text_PetalburgWereSettingSail:
	.string "Capitan Scoglio: Petalipoli, dici?\p"
	.string "Mollate gli ormeggi!\n"
	.string "Peeko, si salpa, tesoro mio!$"

DewfordTown_Text_SlateportWereSettingSail:
	.string "Capitan Scoglio: Porto Selcepoli?\p"
	.string "Mollate gli ormeggi!\n"
	.string "Peeko, si salpa, tesoro mio!$"

DewfordTown_Text_JustTellMeWhenYouNeedToSetSail:
	.string "Capitan Scoglio: Quando devi salpare\n"
	.string "di nuovo, basta che me lo dici!$"

DewfordTown_Text_GettingItchToFish:
	.string "Questo è un famoso posto di pesca.\n"
	.string "Ti è venuta voglia di pescare?$"

DewfordTown_Text_GiveYouOneOfMyRods:
	.string "Così si parla! Mi piace il tuo\n"
	.string "spirito!\p"
	.string "Ti regalo uno dei miei Ami da pesca.$"

DewfordTown_Text_ThrowInFishingAdvice:
	.string "E come bonus, ti do anche qualche\n"
	.string "consiglio da pescatore!\p"
	.string "Per prima cosa, mettiti di fronte\n"
	.string "all'acqua e usa l'Amo.\p"
	.string "Concentrati…\n"
	.string "Se qualcosa abbocca, tira l'Amo.\p"
	.string "A volte si prende subito qualcosa,\n"
	.string "ma con le prede più grosse devi\l"
	.string "tirare l'Amo al momento giusto\l"
	.string "per riuscire a issarle a bordo.\p"
	.string "E occhio: da quando ci sono i Varchi,\n"
	.string "abbocca anche roba mai vista!$"

DewfordTown_Text_ThatsTooBadThen:
	.string "Ah, davvero?\n"
	.string "Peccato, allora.$"

DewfordTown_Text_HowsYourFishing:
	.string "Ehilà!\n"
	.string "Come va la pesca?$"

DewfordTown_Text_GreatHaulInSomeBigOnes:
	.string "Davvero? Fantastico!\n"
	.string "Tira su qualche pezzo grosso!$"

DewfordTown_Text_FishingAdvice:
	.string "Ehi, non buttarti giù!\n"
	.string "Ti do un piccolo consiglio di pesca.\p"
	.string "Per prima cosa, mettiti di fronte\n"
	.string "all'acqua e usa l'Amo.\p"
	.string "Concentrati…\n"
	.string "Se qualcosa abbocca, tira l'Amo.\p"
	.string "A volte si prende subito qualcosa,\n"
	.string "ma con le prede più grosse devi\l"
	.string "tirare l'Amo al momento giusto\l"
	.string "per riuscire a issarle a bordo.$"

DewfordTown_Text_XIsTheBiggestHappeningThingRight:
	.string "Io adoro tutto ciò che fa tendenza.\n"
	.string "Sono sempre sul pezzo, io.\p"
	.string "Senti, hai sentito parlare di questo\n"
	.string "nuovo “{STR_VAR_1}”?\p"
	.string "Esatto!\n"
	.string "Certo che lo conosci!\p"
	.string "Insomma, dai,\n"

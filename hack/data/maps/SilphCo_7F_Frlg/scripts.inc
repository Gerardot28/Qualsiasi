	fadescreen FADE_TO_BLACK
	removeobject 1
	setflag FLAG_KANTO_HIDE_SILPH_RIVAL
	setflag FLAG_KANTO_STORY_NOTEBOOK_BACK
	fadescreen FADE_FROM_BLACK
	releaseall
	end

SilphCo_7F_Frlg_Text_AriannaIntro:
	.string "{PLAYER}?! Anche tu qui?\pIo mi sono infiltrata da sola.\nHo ripreso il mio Taccuino\la una Recluta, al piano di sotto.\pVolevo farcela da sola.\nCome lui. Come Blu.\pAllora, allora! Lottiamo!\nVoglio vedere se ne sono capace!$"

SilphCo_7F_Frlg_Text_AriannaDefeat:
	.string "Ahia… Segno anche questa.$"

SilphCo_7F_Frlg_Text_AriannaAfter:
	.string "Primo: ho perso.\nSecondo: forse me lo meritavo.\pTerzo… da sola non vado da\nnessuna parte.\pIl Taccuino è di nuovo mio, ma\nMorgana ha copiato i dati.\pFacciamo squadra? Io studio\ni Varchi, tu pensi ai Rocket!\pIl Capo è all'undicesimo piano.\nForza, {PLAYER}! Segno tutto!$"

PokemonLeague_ChampionsRoom_Frlg_OnWarp::
	map_script_2 VAR_TEMP_1, 0, PokemonLeague_ChampionsRoom_Frlg_EventScript_TurnPlayerNorth
	.2byte 0

PokemonLeague_ChampionsRoom_Frlg_EventScript_TurnPlayerNorth::
	turnobject LOCALID_PLAYER, DIR_NORTH
	end

PokemonLeague_ChampionsRoom_Frlg_OnFrame::
	map_script_2 VAR_KANTO_LEAGUE, 4, PokemonLeague_ChampionsRoom_Frlg_EventScript_EnterRoom
	.2byte 0

PokemonLeague_ChampionsRoom_Frlg_EventScript_EnterRoom::
	lockall
	applymovement LOCALID_PLAYER, PokemonLeague_ChampionsRoom_Frlg_Movement_PlayerEnter
	waitmovement 0
	delay 20
	msgbox PokemonLeague_ChampionsRoom_Frlg_Text_BluIntro, MSGBOX_DEFAULT
	trainerbattle_no_intro TRAINER_KANTO_CHAMPION_BLU, PokemonLeague_ChampionsRoom_Frlg_Text_BluDefeat
	setvar VAR_KANTO_LEAGUE, 5
	msgbox PokemonLeague_ChampionsRoom_Frlg_Text_BluPostBattle, MSGBOX_DEFAULT
	playbgm MUS_RG_SLOW_PALLET, 0
	clearflag FLAG_KANTO_HIDE_OAK_IN_CHAMP_ROOM
	addobject 2
	msgbox PokemonLeague_ChampionsRoom_Frlg_Text_OakEnters, MSGBOX_DEFAULT
	closemessage
	applymovement LOCALID_PLAYER, PokemonLeague_ChampionsRoom_Frlg_Movement_PlayerWatchOakEnter
	applymovement 1, PokemonLeague_ChampionsRoom_Frlg_Movement_RivalWatchOakEnter
	applymovement 2, PokemonLeague_ChampionsRoom_Frlg_Movement_OakEnter
	waitmovement 0
	msgbox PokemonLeague_ChampionsRoom_Frlg_Text_OakScoldsBlu, MSGBOX_DEFAULT
	msgbox PokemonLeague_ChampionsRoom_Frlg_Text_OakComeWithMe, MSGBOX_DEFAULT
	closemessage
	applymovement 2, PokemonLeague_ChampionsRoom_Frlg_Movement_OakExit
	applymovement LOCALID_PLAYER, PokemonLeague_ChampionsRoom_Frlg_Movement_PlayerExit
	waitmovement 0
	setflag FLAG_KANTO_HIDE_OAK_IN_CHAMP_ROOM
	setvar VAR_TEMP_1, 1
	warp MAP_POKEMON_LEAGUE_HALL_OF_FAME, 5, 12
	waitstate
	releaseall
	end

PokemonLeague_ChampionsRoom_Frlg_EventScript_Blu::
	msgbox PokemonLeague_ChampionsRoom_Frlg_Text_BluAfter, MSGBOX_NPC
	end

PokemonLeague_ChampionsRoom_Frlg_EventScript_Oak::
	msgbox PokemonLeague_ChampionsRoom_Frlg_Text_OakEnters, MSGBOX_NPC
	end

PokemonLeague_ChampionsRoom_Frlg_Text_BluIntro:
	.string "Blu: Ehi, Hoenn! Finalmente!\p"
	.string "Il nonno dice che sei il primo arrivato\n"
	.string "dall'altra parte del Varco.\p"
	.string "Bene: allora sarai il primo a perdere qui!\p"
	.string "Sono il Campione della Lega Pokémon.\n"
	.string "L'Allenatore più forte del mondo… di\p"
	.string "questo mondo, almeno!\p"
	.string "Forza, turista! Fammi vedere cosa sai\n"
	.string "fare!$"

PokemonLeague_ChampionsRoom_Frlg_Text_BluDefeat:
	.string "No! Non può essere! Ho dato il massimo…\n"
	.string "e ho perso lo stesso!$"

PokemonLeague_ChampionsRoom_Frlg_Text_BluPostBattle:
	.string "Blu: …Ok. Il primo in tutto.\p"
	.string "Scrivilo pure sul quaderno della tua\n"
	.string "amica.$"

PokemonLeague_ChampionsRoom_Frlg_Text_OakEnters:
	.string "Prof. Oak: Ohoh! {PLAYER}!$"

PokemonLeague_ChampionsRoom_Frlg_Text_OakScoldsBlu:
	.string "Prof. Oak: Hai vinto! Congratulazioni, di\n"
	.string "cuore!\p"
	.string "E tu, Blu… Hai perso perché hai\n"
	.string "dimenticato una cosa: il rispetto.\p"
	.string "Per i Pokémon… e per chi viene da\n"
	.string "lontano.$"

PokemonLeague_ChampionsRoom_Frlg_Text_OakComeWithMe:
	.string "Prof. Oak: {PLAYER}, la tua vittoria non è\n"
	.string "solo merito tuo.\p"
	.string "Il legame coi tuoi Pokémon ha\n"
	.string "attraversato il cielo intero. È\p"
	.string "meraviglioso.\p"
	.string "{PLAYER}! Vieni con me!$"

PokemonLeague_ChampionsRoom_Frlg_Text_BluAfter:
	.string "Blu: Che vuoi? Sto pensando.\p"
	.string "…Il rispetto, eh. Il nonno ha sempre\n"
	.string "ragione, che nervi.\p"
	.string "Ci vediamo in giro, Campione.$"
@ KANTO_V2 END

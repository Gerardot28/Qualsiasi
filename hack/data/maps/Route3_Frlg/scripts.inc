Route3_Frlg_Text_Youngster:
	.string "Uff… devo riposarmi un attimo…\pDicono che il Monte Luna, qui\navanti, ti sfinisca!$"

Route3_Frlg_Text_RobinIntro:
	.string "Ehi!\nMi hai toccata?$"

Route3_Frlg_Text_RobinDefeat:
	.string "Tutto qui?$"

Route3_Frlg_Text_RobinPostBattle:
	.string "Il Percorso 4 è ai piedi\ndel Monte Luna.$"

Route3_Frlg_Text_JamesIntro:
	.string "Lottiamo con i Pokémon che\nho appena catturato!$"

Route3_Frlg_Text_JamesDefeat:
	.string "Cotto a puntino!$"

Route3_Frlg_Text_JamesPostBattle:
	.string "I Pokémon allenati sono più\nforti di quelli selvatici.$"

Route3_Frlg_Text_SallyIntro:
	.string "Quello sguardo che mi hai\nlanciato… Che intrigo!$"

Route3_Frlg_Text_SallyDefeat:
	.string "Sii gentile!$"

Route3_Frlg_Text_SallyPostBattle:
	.string "Se non ti fai vedere dagli\nAllenatori, eviti le lotte.$"

Route3_Frlg_Text_GregIntro:
	.string "Sei un Allenatore?\nAllora lottiamo subito!$"

Route3_Frlg_Text_GregDefeat:
	.string "Con Pokémon nuovi avrei vinto!$"

Route3_Frlg_Text_GregPostBattle:
	.string "Se un Box del PC è pieno,\npassa a un altro Box.$"

Route3_Frlg_Text_CalvinIntro:
	.string "Ehi! Non porti i calzoncini!\nMa che ti prende?$"

Route3_Frlg_Text_CalvinDefeat:
	.string "Perso!\nPerso! Perso!$"

Route3_Frlg_Text_CalvinPostBattle:
	.string "Io porto sempre i calzoncini,\nanche d'inverno. È una regola!$"

Route3_Frlg_Text_JaniceIntro:
	.string "Scusa!\nMi stavi guardando, vero?$"

Route3_Frlg_Text_JaniceDefeat:
	.string "Che cattiveria!$"

Route3_Frlg_Text_JanicePostBattle:
	.string "Se non vuoi lottare, non\nfissare la gente!$"

Route3_Frlg_Text_ColtonIntro:
	.string "Ehi! Ti ho visto nel\nBosco Smeraldo! O forse no?$"

Route3_Frlg_Text_ColtonDefeat:
	.string "Mi hai battuto di nuovo!$"

Route3_Frlg_Text_ColtonPostBattle:
	.string "Non esistono solo i Pokémon\ndei boschi, sai?\pDicono che dai Varchi arrivino\nperfino insetti mai visti!$"

Route3_Frlg_Text_BenIntro:
	.string "Ciao!\nAdoro i calzoncini!\pSono comodissimi e facili\nda indossare!$"

Route3_Frlg_Text_BenDefeat:
	.string "Non ci credo!$"

Route3_Frlg_Text_BenPostBattle:
	.string "Usi il PC del Centro Pokémon\nper depositare i tuoi Pokémon?\pOgni Box contiene fino a\n30 Pokémon.$"

Route3_Frlg_Text_RouteSign:
	.string "Percorso 3\nPiù avanti: Monte Luna$"

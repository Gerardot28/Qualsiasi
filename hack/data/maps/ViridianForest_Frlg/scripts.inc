ViridianForest_Frlg_Text_Youngster:
	.string "Sono venuto qui con gli amici a catturare\n"
	.string "Pokémon Coleottero!\p"
	.string "Non vedono l'ora di lottare… soprattutto\n"
	.string "con chi viene da un altro mondo!$"

ViridianForest_Frlg_Text_Boy:
	.string "Lanciavo Poké Ball a raffica e le ho\n"
	.string "finite tutte!\p"
	.string "Di Poké Ball non ce ne sono mai\n"
	.string "abbastanza!$"

ViridianForest_Frlg_Text_RickIntro:
	.string "Ehi! Hai dei Pokémon! Dai, lottiamo!$"

ViridianForest_Frlg_Text_RickDefeat:
	.string "No! I miei Caterpie non ce la fanno!$"

ViridianForest_Frlg_Text_RickPostBattle:
	.string "Ssst! Così spaventi gli insetti! Un'altra\n"
	.string "volta, va bene?$"

ViridianForest_Frlg_Text_DougIntro:
	.string "Ehi! Un vero Allenatore non scappa\n"
	.string "davanti a una sfida!$"

ViridianForest_Frlg_Text_DougDefeat:
	.string "Eh? Ho finito i Pokémon!$"

ViridianForest_Frlg_Text_DougPostBattle:
	.string "Che rabbia! Ora vado a catturarne di più\n"
	.string "forti!$"

ViridianForest_Frlg_Text_SammyIntro:
	.string "Ehi, aspetta! Dove corri così di fretta?$"

ViridianForest_Frlg_Text_SammyDefeat:
	.string "Mi arrendo! Che bravura!$"

ViridianForest_Frlg_Text_SammyPostBattle:
	.string "A volte per terra si trovano degli\n"
	.string "strumenti.\p"
	.string "Io cerco quelli che ho perso. Mi dai una\n"
	.string "mano?$"

ViridianForest_Frlg_Text_AnthonyIntro:
	.string "Sarò piccolo, ma guai a te se ci vai piano!$"

ViridianForest_Frlg_Text_AnthonyDefeat:
	.string "Uffa. Non me ne è andata bene una.$"

ViridianForest_Frlg_Text_AnthonyPostBattle:
	.string "Ho perso un po' della mia paghetta…$"

ViridianForest_Frlg_Text_CharlieIntro:
	.string "Lo sai che i Pokémon si evolvono?$"

ViridianForest_Frlg_Text_CharlieDefeat:
	.string "Oh! Ho perso!$"

ViridianForest_Frlg_Text_CharliePostBattle:
	.string "I Pokémon Coleottero si evolvono in\n"
	.string "fretta. Sono uno spasso!$"

ViridianForest_Frlg_Text_TrainerTips1:
	.string "Consigli per Allenatori\p"
	.string "Se i tuoi Pokémon sono deboli e vuoi\n"
	.string "evitare le lotte, stai lontano dall'erba\l"
	.string "alta!$"

ViridianForest_Frlg_Text_TrainerTips3:
	.string "Consigli per Allenatori\p"
	.string "Il Prof. Oak di Biancavilla studia i\n"
	.string "Pokémon di ogni mondo. Fagli vedere il\l"
	.string "tuo Pokédex!$"

ViridianForest_Frlg_Text_TrainerTips4:
	.string "Consigli per Allenatori\p"
	.string "Non puoi catturare i Pokémon degli altri\n"
	.string "Allenatori.\p"
	.string "Lancia le Poké Ball solo ai Pokémon\n"
	.string "selvatici!$"

ViridianForest_Frlg_Text_ExitSign:
	.string "Uscita dal Bosco Smeraldo\n"
	.string "Avanti: Plumbeopoli$"

ViridianForest_Frlg_Text_TrainerTips2:
	.string "Contro il veleno usa un Antidoto! Lo\n"
	.string "trovi in ogni Pokémon Market!$"

ViridianForest_Frlg_Text_TrainerTips5:
	.string "Consigli per Allenatori\p"
	.string "Indebolisci i Pokémon prima di catturarli!\n"
	.string "Se sono in forze, possono scappare!$"

	goto_if_set FLAG_KANTO_BADGE01, PewterCity_Gym_Frlg_EventScript_GymStatueCertified
	msgbox PewterCity_Gym_Frlg_Text_GymStatue, MSGBOX_SIGN
	end

PewterCity_Gym_Frlg_EventScript_GymStatueCertified::

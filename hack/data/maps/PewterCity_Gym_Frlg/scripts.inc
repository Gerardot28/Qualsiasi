	end

PewterCity_Gym_Frlg_Text_GymStatue:
	.string "Palestra Pokémon di Plumbeopoli\n"
	.string "Capopalestra: Brock$"

PewterCity_Gym_Frlg_Text_GymStatueCertified:
	.string "Palestra Pokémon di Plumbeopoli\n"
	.string "Capopalestra: Brock\p"
	.string "Allenatori premiati:\n"
	.string "{PLAYER}$"

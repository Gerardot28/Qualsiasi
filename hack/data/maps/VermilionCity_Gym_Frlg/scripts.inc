VermilionCity_Gym_Frlg_EventScript_TrashCan::
	copyvar VAR_0x8004, VAR_TEMP_0
	copyvar VAR_0x8005, VAR_TEMP_1
	goto_if_set FLAG_KANTO_VERMILION_GYM_SWITCHES, VermilionCity_Gym_Frlg_EventScript_LocksAlreadyOpen
	goto_if_set FLAG_TEMP_1, VermilionCity_Gym_Frlg_EventScript_TrySwitchTwo
	goto_if_eq VAR_0x8004, VAR_0x8008, VermilionCity_Gym_Frlg_EventScript_FoundSwitchOne
	msgbox VermilionCity_Gym_Frlg_Text_NopeOnlyTrashHere
	releaseall
	end

VermilionCity_Gym_Frlg_EventScript_FoundSwitchOne::
	msgbox VermilionCity_Gym_Frlg_Text_SwitchUnderTrashFirstLockOpened
	playse SE_PIN
	waitse
	call VermilionCity_Gym_Frlg_EventScript_SetOneBeamOff
	special DrawWholeMapView
	setflag FLAG_TEMP_1
	releaseall
	end

VermilionCity_Gym_Frlg_EventScript_TrySwitchTwo::
	goto_if_eq VAR_0x8005, VAR_0x8008, VermilionCity_Gym_Frlg_EventScript_FoundSwitchTwo
	msgbox VermilionCity_Gym_Frlg_Text_OnlyTrashLocksWereReset
	clearflag FLAG_TEMP_1
	special SetVermilionTrashCans
	copyvar VAR_TEMP_0, VAR_0x8004
	copyvar VAR_TEMP_1, VAR_0x8005
	call VermilionCity_Gym_Frlg_EventScript_SetBeamsOn
	special DrawWholeMapView
	releaseall
	end

VermilionCity_Gym_Frlg_EventScript_FoundSwitchTwo::
	msgbox VermilionCity_Gym_Frlg_Text_SecondLockOpened
	closemessage
	call VermilionCity_Gym_Frlg_EventScript_SetBeamsOff
	special DrawWholeMapView
	playse SE_UNLOCK
	waitse
	setflag FLAG_KANTO_VERMILION_GYM_SWITCHES
	releaseall
	end

VermilionCity_Gym_Frlg_EventScript_LocksAlreadyOpen::
	msgbox VermilionCity_Gym_Frlg_Text_NopeOnlyTrashHere
	releaseall
	end


VermilionCity_Gym_Frlg_EventScript_LtSurge::
	lock
	faceplayer
	goto_if_set FLAG_KANTO_BADGE03, VermilionCity_Gym_Frlg_EventScript_LtSurgeAfterBadge
	msgbox VermilionCity_Gym_Frlg_Text_LtSurgeIntro, MSGBOX_DEFAULT
	trainerbattle_no_intro TRAINER_KANTO_LEADER_LT_SURGE, VermilionCity_Gym_Frlg_Text_LtSurgeDefeat
	message VermilionCity_Gym_Frlg_Text_ReceivedBadge
	waitmessage
	call Common_EventScript_PlayGymBadgeFanfare
	setflag FLAG_KANTO_BADGE03
	setflag FLAG_KANTO_HIDE_VERMILION_QUARANTINE
	setflag FLAG_KANTO_HIDE_VERMILION_ARIANNA
	setvar VAR_KANTO_STORY, 2
	settrainerflag TRAINER_KANTO_ENGINEER_BAILY
	settrainerflag TRAINER_KANTO_GENTLEMAN_TUCKER
	settrainerflag TRAINER_KANTO_SAILOR_DWAYNE
	msgbox VermilionCity_Gym_Frlg_Text_LtSurgeExplainBadge, MSGBOX_DEFAULT
VermilionCity_Gym_Frlg_EventScript_LtSurgeAfterBadge::
	goto_if_set FLAG_KANTO_GOT_TM_SURGE, VermilionCity_Gym_Frlg_EventScript_LtSurgePostBattle
	giveitem ITEM_TM24
	goto_if_eq VAR_RESULT, FALSE, Common_EventScript_ShowBagIsFull
	setflag FLAG_KANTO_GOT_TM_SURGE
	msgbox VermilionCity_Gym_Frlg_Text_LtSurgeExplainTM, MSGBOX_DEFAULT
	release
	end

VermilionCity_Gym_Frlg_EventScript_LtSurgePostBattle::
	msgbox VermilionCity_Gym_Frlg_Text_LtSurgePostBattle, MSGBOX_DEFAULT
	release
	end

VermilionCity_Gym_Frlg_Text_LtSurgeIntro:
	.string "Ehi, soldato! Una nave uscita da un buco\n"
	.string "nel cielo? Nel MIO porto?\p"
	.string "Prima di sbarcare passi l'ispezione,\n"
	.string "soldato!\p"
	.string "E l'ispezione la faccio io, a colpi di\n"
	.string "fulmini! Vediamo se reggi la scossa!$"

VermilionCity_Gym_Frlg_Text_LtSurgeDefeat:
	.string "Uoh! Che potenza! Ispezione superata,\n"
	.string "soldato!$"

VermilionCity_Gym_Frlg_Text_ReceivedBadge:
	.string "{PLAYER} ha ricevuto\n"
	.string "la Medaglia Tuono da Lt. Surge!$"

VermilionCity_Gym_Frlg_Text_LtSurgeExplainBadge:
	.string "Ispezione superata, soldato! Kanto è\n"
	.string "tua.\p"
	.string "La Medaglia Tuono dimostra che hai retto\n"
	.string "la scossa del mio porto!\p"
	.string "Ho ordinato ai miei agenti di togliere la\n"
	.string "quarantena. Le uscite della città sono\l"
	.string "aperte!$"

VermilionCity_Gym_Frlg_Text_LtSurgeExplainTM:
	.string "Quella che hai ricevuto è la MT24,\n"
	.string "Fulmine!\p"
	.string "Un attacco elettrico potentissimo che a\n"
	.string "volte paralizza il nemico.\p"
	.string "Usala bene, soldato!$"

VermilionCity_Gym_Frlg_Text_LtSurgePostBattle:
	.string "Kanto è grande, soldato! Celestopoli è a\n"
	.string "nord, Lavandonia a est.\p"
	.string "E tieni d'occhio il cielo: dove si apre un\n"
	.string "buco, prima o poi arriva qualcuno!$"


Route12_Frlg_Text_NedIntro:
	.string "Sì! Qualcosa ha abboccato!$"

Route12_Frlg_Text_NedDefeat:
	.string "Tsk! Solo un pesciolino…$"

Route12_Frlg_Text_NedPostBattle:
	.string "Aspetta! Mi si è impigliata la lenza!$"

Route12_Frlg_Text_ChipIntro:
	.string "Pazienza. La pesca è l'arte dell'attesa.$"

Route12_Frlg_Text_ChipDefeat:
	.string "Mi è scappato!$"

Route12_Frlg_Text_ChipPostBattle:
	.string "Con una canna migliore prenderei\n"
	.string "Pokémon migliori…$"

Route12_Frlg_Text_HankIntro:
	.string "Il re della pesca contro l'Allenatore\n"
	.string "venuto dal cielo!$"

Route12_Frlg_Text_HankDefeat:
	.string "Ho tirato troppo!$"

Route12_Frlg_Text_HankPostBattle:
	.string "Ognuno diventa bravo in quel che ama.\p"
	.string "Mi hai battuto a lotta, ma a pescare non\n"
	.string "mi batte nessuno!$"

Route12_Frlg_Text_ElliotIntro:
	.string "Adoro pescare, eh. Ma un lavoretto in\n"
	.string "più non mi dispiacerebbe.$"

Route12_Frlg_Text_ElliotDefeat:
	.string "Non è facile…$"

Route12_Frlg_Text_ElliotPostBattle:
	.string "Va bene così. Perdere non mi pesa più.$"

Route12_Frlg_Text_LucaIntro:
	.string "L'elettricità è la mia specialità! Dei\n"
	.string "Pokémon marini, però, non so niente.$"

Route12_Frlg_Text_LucaDefeat:
	.string "Staccato!$"

Route12_Frlg_Text_LucaPostBattle:
	.string "L'acqua conduce l'elettricità. Fulmina i\n"
	.string "Pokémon marini!$"

Route12_Frlg_Text_JustinIntro:
	.string "Cerco una Pietralunare. Ne hai trovata\n"
	.string "una?$"

Route12_Frlg_Text_JustinDefeat:
	.string "Ahi!$"

Route12_Frlg_Text_JustinPostBattle:
	.string "Con una Pietralunare avrei fatto\n"
	.string "evolvere i miei Pokémon.\p"
	.string "Dicono che quelle del Monte Luna siano\n"
	.string "cadute dal cielo!$"

Route12_Frlg_Text_AndrewIntro:
	.string "Cosa abbocca oggi? Non si sa mai cosa si\n"
	.string "pesca!$"

Route12_Frlg_Text_AndrewDefeat:
	.string "Perso!$"

Route12_Frlg_Text_AndrewPostBattle:
	.string "Magikarp? Ne pesco a bizzeffe, ma sono\n"
	.string "dei mollaccioni.\p"
	.string "Però l'altro giorno ne ho preso uno di un\n"
	.string "colore mai visto. Che venisse dal\p"
	.string "Varco?$"

Route12_Frlg_Text_GiaIntro:
	.string "Gia: Ehi, Jes…\p"
	.string "Se vinciamo, ti sposo!$"

Route12_Frlg_Text_GiaDefeat:
	.string "Gia: Oh, ma perché?$"

Route12_Frlg_Text_GiaPostBattle:
	.string "Gia: Jes, pasticcione! Hai rovinato\n"
	.string "tutto!$"

Route12_Frlg_Text_GiaNotEnough:
	.string "Gia: Non posso lottare senza il mio Jes!\n"
	.string "Non hai un altro Pokémon?$"

Route12_Frlg_Text_JesIntro:
	.string "Jes: Se vinciamo, chiedo a Gia di\n"
	.string "sposarmi.$"

Route12_Frlg_Text_JesDefeat:
	.string "Jes: Ti prego, perché non ci hai lasciato\n"
	.string "vincere?$"

Route12_Frlg_Text_JesPostBattle:
	.string "Jes: Oh, Gia, perdonami, amore mio!$"

Route12_Frlg_Text_JesNotEnough:
	.string "Jes: Gia e io staremo sempre insieme.\p"
	.string "Non lottiamo se non hai almeno due\n"
	.string "Pokémon.$"

Route12_Frlg_Text_RouteSign:
	.string "Percorso 12\n"
	.string "{UP_ARROW} Lavandonia$"

Route12_Frlg_Text_FishingSign:
	.string "Area di pesca sportiva$"


CinnabarIsland_Gym_Frlg_EventScript_Blaine::
	lock
	faceplayer
	goto_if_set FLAG_KANTO_BADGE07, CinnabarIsland_Gym_Frlg_EventScript_BlaineAfterBadge
	msgbox CinnabarIsland_Gym_Frlg_Text_BlaineIntro, MSGBOX_DEFAULT
	trainerbattle_no_intro TRAINER_KANTO_LEADER_BLAINE, CinnabarIsland_Gym_Frlg_Text_BlaineDefeat
	message CinnabarIsland_Gym_Frlg_Text_ReceivedBadge
	waitmessage
	call Common_EventScript_PlayGymBadgeFanfare
	setflag FLAG_KANTO_BADGE07
	settrainerflag TRAINER_KANTO_BURGLAR_DUSTY
	settrainerflag TRAINER_KANTO_BURGLAR_QUINN
	settrainerflag TRAINER_KANTO_BURGLAR_RAMON
	settrainerflag TRAINER_KANTO_SUPER_NERD_AVERY
	settrainerflag TRAINER_KANTO_SUPER_NERD_DEREK
	settrainerflag TRAINER_KANTO_SUPER_NERD_ERIK

CinnabarIsland_Gym_Frlg_EventScript_BlaineAfterBadge::
	goto_if_set FLAG_KANTO_GOT_TM_BLAINE, CinnabarIsland_Gym_Frlg_EventScript_BlainePostBattle
	giveitem ITEM_TM38
	goto_if_eq VAR_RESULT, FALSE, Common_EventScript_ShowBagIsFull
	setflag FLAG_KANTO_GOT_TM_BLAINE
	msgbox CinnabarIsland_Gym_Frlg_Text_BlaineExplainTM, MSGBOX_DEFAULT
	release
	end


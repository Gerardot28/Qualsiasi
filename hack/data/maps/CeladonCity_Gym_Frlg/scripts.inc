	lock
	faceplayer
	goto_if_set FLAG_KANTO_BADGE04, CeladonCity_Gym_Frlg_EventScript_ErikaAfterBadge
	msgbox CeladonCity_Gym_Frlg_Text_ErikaIntro, MSGBOX_DEFAULT

	settrainerflag TRAINER_KANTO_LASS_KAY
	settrainerflag TRAINER_KANTO_LASS_LISA
	settrainerflag TRAINER_KANTO_PICNICKER_TINA
	msgbox CeladonCity_Gym_Frlg_Text_ErikaExplainBadge, MSGBOX_DEFAULT
CeladonCity_Gym_Frlg_EventScript_ErikaAfterBadge::
	goto_if_set FLAG_KANTO_GOT_TM_ERIKA, CeladonCity_Gym_Frlg_EventScript_ErikaPostBattle
	giveitem ITEM_TM19
	goto_if_eq VAR_RESULT, FALSE, Common_EventScript_ShowBagIsFull
	setflag FLAG_KANTO_GOT_TM_ERIKA
	msgbox CeladonCity_Gym_Frlg_Text_ErikaExplainTM, MSGBOX_DEFAULT
	release
	end

CeladonCity_Gym_Frlg_EventScript_ErikaPostBattle::
	msgbox CeladonCity_Gym_Frlg_Text_ErikaPostBattle, MSGBOX_DEFAULT
	release
	end

CeladonCity_Gym_Frlg_Text_ErikaIntro:
	.string "Salve…\n"
	.string "Che bella giornata, vero?\l"
	.string "Si sta così bene…\p"
	.string "…Oh, cielo…\n"
	.string "Devo essermi appisolata. Benvenuto.\p"
	.string "Mi chiamo Erika.\n"
	.string "Sono la Capopalestra di Azzurropoli.\p"
	.string "Vieni dall'altra parte del Varco,\n"
	.string "vero? Il profumo lo dice.\p"
	.string "I fiori si chiudono quando passa\n"
	.string "un Varco…\p"
	.string "…e anche quando passa il Team Rocket.\n"
	.string "Ultimamente si chiudono spesso.\p"
	.string "I miei Pokémon sono tutti di tipo\n"
	.string "Erba. Vuoi sfidarmi?\p"
	.string "Molto bene. Ma non perderò.$"

CeladonCity_Gym_Frlg_Text_ErikaDefeat:
	.string "Oh!\n"
	.string "Mi arrendo.\l"
	.string "Sei davvero molto forte.\p"
	.string "Ti consegno la Medaglia\n"
	.string "Arcobaleno.$"

CeladonCity_Gym_Frlg_Text_ReceivedBadge:
	.string "{PLAYER} riceve la Medaglia\n"
	.string "Arcobaleno da Erika!$"

CeladonCity_Gym_Frlg_Text_ErikaExplainBadge:
	.string "La Medaglia Arcobaleno prova che\n"
	.string "i fiori di Kanto si fidano di te.\p"
	.string "Il Casinò qui vicino… i miei fiori\n"
	.string "non vi si aprono mai.\p"
	.string "Se scoprirai cosa nasconde, fallo\n"
	.string "per tutta Azzurropoli.\p"
	.string "Ti prego, prendi anche questa.$"

CeladonCity_Gym_Frlg_Text_ErikaExplainTM:
	.string "La MT19 contiene Gigassorbimento.\p"
	.string "Metà del danno inflitto viene\n"
	.string "assorbita per curare il tuo Pokémon.\p"
	.string "Non trovi che sia una mossa\n"
	.string "meravigliosa?$"

CeladonCity_Gym_Frlg_Text_ErikaPostBattle:
	.string "Il tuo mondo ha dei fiori?\n"
	.string "Mi piacerebbe vederli, un giorno.\p"
	.string "Se un Varco lascia passare i fiori,\n"
	.string "non può essere una cosa cattiva.$"


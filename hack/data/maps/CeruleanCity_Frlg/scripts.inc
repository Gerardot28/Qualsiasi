CeruleanCity_Frlg_EventScript_Arianna::
	msgbox CeruleanCity_Frlg_Text_Arianna, MSGBOX_NPC
	end

CeruleanCity_Frlg_Text_BluScene1:
	.string "Blu: Ehi, Hoenn! Sei tu il turista della\n"
	.string "nave uscita dal cielo?\p"
	.string "E lei chi è? Quella con il quaderno?\p"
	.string "Arianna: Non è un quaderno! È il\n"
	.string "Taccuino dei Varchi!\p"
	.string "Dentro ci sono tutti i Varchi di Hoenn!\p"
	.string "Blu: Un quaderno? Mio nonno ha un\n"
	.string "laboratorio intero.\p"
	.string "Sono Blu, il Campione di Kanto. Nipote\n"
	.string "del Prof. Oak.\p"
	.string "Per studiare i Varchi di Kanto basta il\n"
	.string "nonno. Grazie lo stesso.\p"
	.string "Ci vediamo all'Altopiano, turista!$"

CeruleanCity_Frlg_Text_BluScene2:
	.string "Arianna: …Un quaderno. Ha detto\n"
	.string "quaderno!\p"
	.string "Bene. Allora vado da sola al Monte Luna.\p"
	.string "Dicono che le sue pietre vibrino vicino\n"
	.string "alla Soglia.\p"
	.string "Se trovo un Varco prima di lui…\p"
	.string "…gli faccio vedere io cosa c'è in questo\n"
	.string "“quaderno”!\p"
	.string "Non seguirmi, {PLAYER}! Stavolta ce la\n"
	.string "faccio da sola!$"

CeruleanCity_Frlg_Text_Arianna:
	.string "Arianna: Allora, allora! Celestopoli ha\n"
	.string "una Palestra di tipo Acqua.\p"
	.string "Primo: tu vinci. Secondo: io segno tutto.\n"
	.string "Terzo… si va a nord!$"
@ KANTO_V2 END

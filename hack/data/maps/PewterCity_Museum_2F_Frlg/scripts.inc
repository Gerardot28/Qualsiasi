	msgbox PewterCity_Museum_2F_Frlg_Text_RoccoAfter, MSGBOX_DEFAULT
	release
	end

PewterCity_Museum_2F_Frlg_Text_Rocco:
	.string "Oh, {PLAYER}! Che bella sorpresa trovarti\n"
	.string "qui.\p"
	.string "Sono venuto a Kanto col secondo viaggio\n"
	.string "della M/N Acqua. Volevo vedere questa\l"
	.string "pietra con i miei occhi.\p"
	.string "È una Pietralunare. Viene da un Varco\n"
	.string "antico, come il nostro Meteorite di\l"
	.string "Hoenn. Interessante…\p"
	.string "Vibra quando si avvicina alla Soglia. Ne\n"
	.string "ho trovata un'altra al Monte Luna:\l"
	.string "tienila tu, potrebbe esserti utile.$"

PewterCity_Museum_2F_Frlg_Text_RoccoAfter:
	.string "Le pietre cadute dai Varchi raccontano\n"
	.string "storie antichissime.\p"
	.string "Kanto e Hoenn sono più vicine di quanto\n"
	.string "pensassimo. Interessante…$"

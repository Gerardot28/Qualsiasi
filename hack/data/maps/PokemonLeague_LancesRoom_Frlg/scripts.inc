PokemonLeague_LancesRoom_Frlg_OnLoad::
	call_if_set FLAG_KANTO_DEFEATED_LANCE, PokemonLeague_LancesRoom_Frlg_EventScript_SetDoorOpen
	call_if_eq VAR_KANTO_LEAGUE, 4, PokemonLeague_LancesRoom_Frlg_EventScript_CloseEntry
	end

PokemonLeague_LancesRoom_Frlg_EventScript_SetDoorOpen::
	call KantoLeague_EventScript_SetDoorOpenLance
	return

PokemonLeague_LancesRoom_Frlg_EventScript_CloseEntry::
	call PokemonLeague_LancesRoom_Frlg_EventScript_SetEntryClosed
	return

PokemonLeague_LancesRoom_Frlg_OnWarp::
	map_script_2 VAR_TEMP_1, 0, PokemonLeague_LancesRoom_Frlg_EventScript_TurnPlayerNorth
	.2byte 0

PokemonLeague_LancesRoom_Frlg_EventScript_TurnPlayerNorth::
	turnobject LOCALID_PLAYER, DIR_NORTH
	end

PokemonLeague_LancesRoom_Frlg_OnFrame::
	map_script_2 VAR_KANTO_LEAGUE, 3, PokemonLeague_LancesRoom_Frlg_EventScript_EnterRoom
	.2byte 0

PokemonLeague_LancesRoom_Frlg_EventScript_EnterRoom::
	lockall
	applymovement LOCALID_PLAYER, PokemonLeague_LancesRoom_Frlg_Movement_WalkThroughCorridor
	waitmovement 0
	call PokemonLeague_LancesRoom_Frlg_EventScript_SetEntryClosed
	playse SE_UNLOCK
	special DrawWholeMapView
	setvar VAR_KANTO_LEAGUE, 4
	releaseall
	end

PokemonLeague_LancesRoom_Frlg_EventScript_Lance::
	lock
	faceplayer
	goto_if_set FLAG_KANTO_DEFEATED_LANCE, PokemonLeague_LancesRoom_Frlg_EventScript_LancePostBattle
	msgbox PokemonLeague_LancesRoom_Frlg_Text_LanceIntro, MSGBOX_DEFAULT
	trainerbattle_no_intro TRAINER_KANTO_ELITE_FOUR_LANCE, PokemonLeague_LancesRoom_Frlg_Text_LanceDefeat
	setflag FLAG_KANTO_DEFEATED_LANCE
	call KantoLeague_EventScript_OpenDoorLance
PokemonLeague_LancesRoom_Frlg_EventScript_LancePostBattle::
	msgbox PokemonLeague_LancesRoom_Frlg_Text_LancePostBattle, MSGBOX_DEFAULT
	release
	end


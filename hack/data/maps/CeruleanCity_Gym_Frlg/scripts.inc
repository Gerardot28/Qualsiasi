	end

@ object 2 OBJ_EVENT_GFX_PICNICKER_FRLG at (4,7), was CeruleanCity_Gym_EventScript_Diana; trainer TRAINER_PICNICKER_DIANA TRAINER_TYPE_NORMAL sight 4
CeruleanCity_Gym_Frlg_EventScript_Diana::
	trainerbattle_single TRAINER_KANTO_PICNICKER_DIANA, CeruleanCity_Gym_Frlg_Text_DianaIntro, CeruleanCity_Gym_Frlg_Text_DianaDefeat
	msgbox CeruleanCity_Gym_Frlg_Text_DianaPostBattle, MSGBOX_AUTOCLOSE
	end

@ object 3 OBJ_EVENT_GFX_MISTY at (8,6), was CeruleanCity_Gym_EventScript_Misty; battle TRAINER_LEADER_MISTY

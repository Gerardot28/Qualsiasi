CeruleanCity_Gym_Frlg_Text_LuisIntro:
	.string "Splash! Il primo sono io! Tuffiamoci!$"

CeruleanCity_Gym_Frlg_Text_LuisDefeat:
	.string "Non può essere!$"

CeruleanCity_Gym_Frlg_Text_LuisPostBattle:
	.string "Misty migliora ogni giorno.\p"
	.string "Contro di lei non basterà venire da un\n"
	.string "altro mondo!$"

CeruleanCity_Gym_Frlg_Text_DianaIntro:
	.string "Cosa? Tu? Basto e avanzo io!\p"
	.string "Misty non deve nemmeno disturbarsi.$"

CeruleanCity_Gym_Frlg_Text_DianaDefeat:
	.string "Mi hai travolta come un'onda!$"

CeruleanCity_Gym_Frlg_Text_DianaPostBattle:
	.string "Solo lottando contro tanti Allenatori\n"
	.string "capisci quanto vali davvero.$"

@ KANTO_V2 BEGIN (tools/kanto/kanto_story.py: regenerated, filled texts are kept)
CeruleanCity_Gym_Frlg_EventScript_Misty::
	lock
	faceplayer
	goto_if_set FLAG_KANTO_BADGE02, CeruleanCity_Gym_Frlg_EventScript_MistyAfterBadge
	msgbox CeruleanCity_Gym_Frlg_Text_MistyIntro, MSGBOX_DEFAULT
	trainerbattle_no_intro TRAINER_KANTO_LEADER_MISTY, CeruleanCity_Gym_Frlg_Text_MistyDefeat
	message CeruleanCity_Gym_Frlg_Text_ReceivedBadge
	waitmessage
	call Common_EventScript_PlayGymBadgeFanfare
	setflag FLAG_KANTO_BADGE02
	settrainerflag TRAINER_KANTO_PICNICKER_DIANA
	settrainerflag TRAINER_KANTO_SWIMMER_MALE_LUIS
	msgbox CeruleanCity_Gym_Frlg_Text_MistyExplainBadge, MSGBOX_DEFAULT
CeruleanCity_Gym_Frlg_EventScript_MistyAfterBadge::
	goto_if_set FLAG_KANTO_GOT_TM_MISTY, CeruleanCity_Gym_Frlg_EventScript_MistyPostBattle
	giveitem ITEM_TM18
	goto_if_eq VAR_RESULT, FALSE, Common_EventScript_ShowBagIsFull
	setflag FLAG_KANTO_GOT_TM_MISTY
	msgbox CeruleanCity_Gym_Frlg_Text_MistyExplainTM, MSGBOX_DEFAULT
	release
	end

CeruleanCity_Gym_Frlg_EventScript_MistyPostBattle::
	msgbox CeruleanCity_Gym_Frlg_Text_MistyPostBattle, MSGBOX_DEFAULT
	release
	end

CeruleanCity_Gym_Frlg_Text_MistyIntro:
	.string "Ehi, una faccia nuova! Vieni dalla nave\n"
	.string "uscita dal cielo, vero?\p"
	.string "Campione di un altro mondo? E allora?\n"
	.string "Qui l'acqua è mia!\p"
	.string "La mia tattica? Attacco totale con i\n"
	.string "Pokémon di tipo Acqua!\p"
	.string "Fatti sotto!$"

CeruleanCity_Gym_Frlg_Text_MistyDefeat:
	.string "Uffa! Sei troppo forte!\p"
	.string "E va bene… La Medaglia Cascata è tua.\n"
	.string "Te la sei meritata.$"

CeruleanCity_Gym_Frlg_Text_ReceivedBadge:
	.string "{PLAYER} riceve la Medaglia Cascata da\n"
	.string "Misty!$"

CeruleanCity_Gym_Frlg_Text_MistyExplainBadge:
	.string "La Medaglia Cascata dimostra che hai\n"
	.string "battuto me, Misty di Celestopoli!\p"
	.string "A Kanto gli Allenatori ti prenderanno\n"
	.string "sul serio. Un po' come fanno con me!\p"
	.string "E prendi anche questa!$"

CeruleanCity_Gym_Frlg_Text_MistyExplainTM:
	.string "La MT18 contiene Pioggiadanza.\p"
	.string "Fa piovere per qualche turno e rende\n"
	.string "più potenti le mosse di tipo Acqua.\p"
	.string "Usala bene, e ricordati di me quando\n"
	.string "piove!$"

CeruleanCity_Gym_Frlg_Text_MistyPostBattle:
	.string "Il Varco ha portato Pokémon d'acqua mai\n"
	.string "visti nei fiumi di Celestopoli.\p"
	.string "E non pensare che mi abbiano aiutata a\n"
	.string "perdere!\p"
	.string "Torna per una rivincita, quando vuoi!$"

CeruleanCity_Gym_Frlg_EventScript_GymGuy::
	lock
	faceplayer
	goto_if_set FLAG_KANTO_BADGE02, CeruleanCity_Gym_Frlg_EventScript_GymGuyPostVictory
	msgbox CeruleanCity_Gym_Frlg_Text_GymGuy, MSGBOX_DEFAULT
	release
	end

CeruleanCity_Gym_Frlg_EventScript_GymGuyPostVictory::
	msgbox CeruleanCity_Gym_Frlg_Text_GymGuyPostVictory, MSGBOX_DEFAULT
	release
	end

CeruleanCity_Gym_Frlg_Text_GymGuy:
	.string "Ehi, Campione di Hoenn! Hai voglia di un\n"
	.string "tuffo a Kanto?\p"
	.string "Misty usa Pokémon di tipo Acqua. Porta\n"
	.string "Pokémon di tipo Erba o Elettro!\p"
	.string "E occhio alle sue mosse veloci: la Sirena\n"
	.string "non perdona!$"

CeruleanCity_Gym_Frlg_Text_GymGuyPostVictory:
	.string "Grande! Hai fatto fare un bel bagno a\n"
	.string "Misty!$"


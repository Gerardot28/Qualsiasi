	goto_if_set FLAG_KANTO_BADGE02, CeruleanCity_Gym_Frlg_EventScript_GymStatueCertified
	msgbox CeruleanCity_Gym_Frlg_Text_GymStatue, MSGBOX_SIGN
	end

CeruleanCity_Gym_Frlg_EventScript_GymStatueCertified::

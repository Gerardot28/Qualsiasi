Route16_Frlg_Text_LaoIntro:
	.string "Che hai da guardare? Mai visto un\n"
	.string "Centauro?$"

Route16_Frlg_Text_LaoDefeat:
	.string "Non osare ridere!$"

Route16_Frlg_Text_LaoPostBattle:
	.string "A noi piace stare qui. Qualche problema?$"

Route16_Frlg_Text_KojiIntro:
	.string "Bella Bici! Passamela!$"

Route16_Frlg_Text_KojiDefeat:
	.string "K.O.!$"

Route16_Frlg_Text_KojiPostBattle:
	.string "Lascia stare, chi la vuole la tua Bici!$"

Route16_Frlg_Text_LukeIntro:
	.string "Vieni fuori a giocare, topolino!$"

Route16_Frlg_Text_LukeDefeat:
	.string "Brutto topastro!$"

Route16_Frlg_Text_LukePostBattle:
	.string "Odio perdere! Sparisci!$"

Route16_Frlg_Text_RubenIntro:
	.string "Ehi, tu! Facciamoci due risate!$"

Route16_Frlg_Text_RubenDefeat:
	.string "Non farmi arrabbiare!$"

Route16_Frlg_Text_RubenPostBattle:
	.string "Mi diverto a spaventare la gente con i\n"
	.string "miei Pokémon puzzolenti.\p"
	.string "Ma solo un pochino, eh!$"

Route16_Frlg_Text_HideoIntro:
	.string "Ehi, mi hai urtato!$"

Route16_Frlg_Text_HideoDefeat:
	.string "Kaboom!$"

Route16_Frlg_Text_HideoPostBattle:
	.string "Noi restiamo qui, che ti piaccia o no.\p"
	.string "Da Fucsiapoli puoi tornare ad Aranciopoli\n"
	.string "seguendo la costa.$"

Route16_Frlg_Text_CamronIntro:
	.string "Ho fame e sono di pessimo umore! Mi serve\n"
	.string "un sacco da boxe!$"

Route16_Frlg_Text_CamronDefeat:
	.string "Male, male, male!$"

Route16_Frlg_Text_CamronPostBattle:
	.string "Se devo avere dei Pokémon, che almeno\n"
	.string "siano feroci.\p"
	.string "Tipo quelli che dicono arrivati dal Varco…$"

Route16_Frlg_Text_LeaIntro:
	.string "Lea: A volte l'intensità del nostro amore\n"
	.string "mi spaventa!$"

Route16_Frlg_Text_LeaDefeat:
	.string "Lea: Oh! Ma Jed è bellissimo anche\n"
	.string "quando perde!$"

Route16_Frlg_Text_LeaPostBattle:
	.string "Lea: Ehehe, scusa. Jed è troppo bello.$"

Route16_Frlg_Text_LeaNotEnough:
	.string "Lea: Noi lottiamo sempre in coppia! Torna\n"
	.string "con almeno due Pokémon.$"

Route16_Frlg_Text_JedIntro:
	.string "Jed: Il nostro amore non ha confini!\n"
	.string "Nemmeno quelli tra i mondi!$"

Route16_Frlg_Text_JedDefeat:
	.string "Jed: Oh, no! Il mio amore mi ha visto\n"
	.string "perdere!$"

Route16_Frlg_Text_JedPostBattle:
	.string "Jed: Senti, Lea… forse dovresti guardare\n"
	.string "un po' meno me e un po' più la lotta.$"

Route16_Frlg_Text_JedNotEnough:
	.string "Jed: Una lotta in coppia richiede due\n"
	.string "Pokémon. Non ne hai abbastanza!$"

Route16_Frlg_Text_RouteSign:
	.string "Percorso 16\n"
	.string "Azzurropoli - Fucsiapoli$"

Route16_Frlg_Text_CyclingRoadSign:

VermilionCity_Frlg_OnFrame::
	map_script_2 VAR_KANTO_STORY, 0, VermilionCity_Frlg_EventScript_ArrivalScene
	.2byte 0

VermilionCity_Frlg_EventScript_ArrivalScene::
	lockall
	applymovement LOCALID_KANTO_VERMILION_ARIANNA, Common_Movement_WalkInPlaceFasterDown
	waitmovement 0
	msgbox VermilionCity_Frlg_Text_ArrivalArianna, MSGBOX_DEFAULT
	msgbox VermilionCity_Frlg_Text_ArrivalQuarantine, MSGBOX_DEFAULT
	setvar VAR_KANTO_STORY, 1
	releaseall
	end

VermilionCity_Frlg_EventScript_Arianna::
	msgbox VermilionCity_Frlg_Text_Arianna, MSGBOX_NPC
	end

VermilionCity_Frlg_EventScript_Quarantine::
	msgbox VermilionCity_Frlg_Text_Quarantine, MSGBOX_NPC
	end

VermilionCity_Frlg_EventScript_QuarantineNorth::
	goto_if_set FLAG_KANTO_HIDE_VERMILION_QUARANTINE, Common_EventScript_NopReturn
	lockall
	msgbox VermilionCity_Frlg_Text_Quarantine, MSGBOX_DEFAULT
	goto KantoStory_EventScript_PushDown

VermilionCity_Frlg_EventScript_QuarantineEast::
	goto_if_set FLAG_KANTO_HIDE_VERMILION_QUARANTINE, Common_EventScript_NopReturn
	lockall
	msgbox VermilionCity_Frlg_Text_Quarantine, MSGBOX_DEFAULT
	goto KantoStory_EventScript_PushLeft

VermilionCity_Frlg_Text_ArrivalArianna:
	.string "Arianna: Allora, allora! Ci siamo!\p"
	.string "Primo: siamo i primi. Secondo: siamo a\n"
	.string "Kanto. Terzo… lo segno!\p"
	.string "Aranciopoli… Il porto di un altro mondo,\n"
	.string "{PLAYER}! Senti che profumo di mare?$"

VermilionCity_Frlg_Text_ArrivalQuarantine:
	.string "Ehi, voi due della nave! Fermi lì!\p"
	.string "Una nave uscita dal cielo! Ordini del\n"
	.string "Capitano Surge: nessuno lascia il porto\l"
	.string "senza la sua ispezione.\p"
	.string "Le uscite della città restano chiuse\n"
	.string "finché il Capitano non vi dà il via.\p"
	.string "Lo trovate in Palestra, qui in città!$"

VermilionCity_Frlg_Text_Arianna:
	.string "Io resto qui a compilare i moduli della\n"
	.string "quarantena… Sono dodici pagine!\p"
	.string "Tu vai in Palestra da Surge. È lui che\n"
	.string "decide se possiamo lasciare il porto.\p"
	.string "Primo: vinci. Secondo: torna. Terzo… lo\n"
	.string "segno!$"

VermilionCity_Frlg_Text_Quarantine:
	.string "Alt! Quarantena portuale!\p"
	.string "Ordini del Capitano Surge: nessuno esce\n"
	.string "da Aranciopoli senza aver superato la\l"
	.string "sua ispezione.\p"
	.string "La Palestra è in città. Vai a parlare con\n"
	.string "lui!$"
@ KANTO_V2 END

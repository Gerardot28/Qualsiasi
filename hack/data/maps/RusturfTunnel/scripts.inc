RusturfTunnel_EventScript_Mike::
	trainerbattle_single TRAINER_MIKE_2, RusturfTunnel_Text_MikeIntro, RusturfTunnel_Text_MikeDefeat
	msgbox RusturfTunnel_Text_MikePostBattle, MSGBOX_AUTOCLOSE
	end

RusturfTunnel_Text_ComeAndGetSome:
	.string "Che c'è, terricolo? Vuoi avvicinarti?\n"
	.string "Fatti sotto, allora!$"

RusturfTunnel_Text_Peeko:
	.string "Peeko: Piii pihyoh!$"

RusturfTunnel_Text_GruntIntro:
	.string "Arrr! Che mi venga un colpo di mare!\p"
	.string "Quel Pokémon in ostaggio non è servito\n"
	.string "proprio a niente!\p"
	.string "E pensare che sono scappato fin qui…\n"
	.string "in un tunnel senza uscita!\p"
	.string "Ehi, tu! Questa merce serve al Capo\n"
	.string "Ulisse: con lei terremo aperto un Varco\l"
	.string "per sempre!\p"
	.string "La rivuoi? Allora devi battermi!$"

RusturfTunnel_Text_GruntDefeat:
	.string "Arrrgh! La mia carriera da pirata\n"
	.string "finisce in un vicolo cieco!$"

RusturfTunnel_Text_GruntTakePackage:
	.string "Non è giusto, non è proprio giusto…\p"
	.string "Il Capo mi aveva detto che sarebbe\n"
	.string "stato un colpo facile facile.\p"
	.string "Dovevo solo rubare un pacco alla\n"
	.string "Devon, e via col vento!\p"
	.string "Tsk!\n"
	.string "Se ci tieni tanto, riprenditelo!$"

RusturfTunnel_Text_PeekoGladToSeeYouSafe:
	.string "Peeko!\n"
	.string "Che gioia rivederti, stai bene!$"

RusturfTunnel_Text_ThankYouLetsGoHomePeeko:
	.string "Peeko ti deve la vita!\p"
	.string "Tutti mi chiamano Capitan Scoglio.\n"
	.string "E tu, chi sei?\p"
	.string "… … … … … … … …\n"
	.string "… … … … … … … …\p"
	.string "Ah, dunque tu sei {PLAYER}{KUN}!\n"
	.string "Ti ringrazio di cuore!\p"
	.string "Se mai ti servisse un passaggio per\n"
	.string "mare, la mia barca è tua!\l"
	.string "E per qualsiasi guaio, chiedi pure!\p"
	.string "Di solito mi trovi nella mia casetta\n"
	.string "sul mare, vicino al Bosco Petalo.\p"
	.string "Vieni, Peeko, è ora di tornare\n"
	.string "a casa.\p"
	.string "Peeko: Pihyoh!$"

RusturfTunnel_Text_WhyCantTheyKeepDigging:
	.string "… …\p"
	.string "Perché non possono più scavare?\n"
	.string "La roccia è troppo dura?\p"
	.string "La mia amata mi aspetta a Mentania,\n"
	.string "proprio qui, dall'altra parte…\p"
	.string "Se questo tunnel unisse Ferrugipoli\n"
	.string "e Mentania, potrei andare a trovarla\l"
	.string "ogni giorno…\p"
	.string "Ma così…\n"
	.string "Cosa posso fare?$"

RusturfTunnel_Text_ToGetToVerdanturf:
	.string "Per andare da Ferrugipoli a Mentania\n"
	.string "bisogna passare da Bluruvia, poi da\l"
	.string "Porto Selcepoli e da Ciclamipoli…$"

RusturfTunnel_Text_YouShatteredBoulderTakeHM:
	.string "Wow! Hai frantumato il masso che\n"
	.string "bloccava il passaggio!\p"
	.string "Per dimostrarti quanto te ne sono\n"
	.string "grato, voglio darti questa MN.$"

RusturfTunnel_Text_ExplainStrength:
	.string "Quella MN contiene Forza.\p"
	.string "Se un Pokémon muscoloso la impara,\n"
	.string "riesce a spostare persino i massi\l"
	.string "più grandi.$"

RusturfTunnel_Text_WandaReunion:
	.string "Wanda!\n"
	.string "Adesso posso vederti quando voglio!\p"
	.string "Wanda: È… meraviglioso.\p"
	.string "Ti prego, vieni a riposarti a casa mia.$"

RusturfTunnel_Text_BoyfriendOnOtherSideOfRock:
	.string "Dall'altra parte di questa roccia…\n"
	.string "c'è il mio ragazzo.\p"
	.string "Lui… non scava il tunnel solo per\n"
	.string "venire a trovarmi.\p"
	.string "Si consuma le mani a forza di lavorare\n"
	.string "per il bene di tutti.$"

RusturfTunnel_Text_MikeIntro:
	.string "Come si chiama un uomo che vive in\n"
	.string "montagna? Un montanaro, giusto?\p"
	.string "E allora perché un Pokémon di montagna\n"
	.string "non si chiama Pokémontanaro?$"

RusturfTunnel_Text_MikeDefeat:
	.string "I miei Pokémon…\n"
	.string "Sono rimasti senza fiato…$"

RusturfTunnel_Text_MikePostBattle:
	.string "Hanno fermato i lavori per proteggere\n"
	.string "i Pokémon, giusto?\l"
	.string "Una storia che scalda il cuore!$"


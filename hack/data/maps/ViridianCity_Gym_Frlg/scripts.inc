	msgbox ViridianCity_Gym_Frlg_Text_GiovanniExplainBadge, MSGBOX_DEFAULT
ViridianCity_Gym_Frlg_EventScript_GiovanniAfterBadge::
	goto_if_set FLAG_KANTO_GOT_TM_GIOVANNI, ViridianCity_Gym_Frlg_EventScript_GiovanniPostBattle
	giveitem ITEM_TM26
	goto_if_eq VAR_RESULT, FALSE, Common_EventScript_ShowBagIsFull
	setflag FLAG_KANTO_GOT_TM_GIOVANNI
	msgbox ViridianCity_Gym_Frlg_Text_GiovanniExplainTM, MSGBOX_DEFAULT
	release
	end

ViridianCity_Gym_Frlg_EventScript_GiovanniPostBattle::
	msgbox ViridianCity_Gym_Frlg_Text_GiovanniPostBattle, MSGBOX_DEFAULT
	release
	end

ViridianCity_Gym_Frlg_Text_GiovanniIntro:
	.string "Eccoti. Il Campione venuto dall'altra\n"
	.string "parte del Varco.\p"
	.string "Sì, questa è la mia Palestra. Il Capo del\n"
	.string "Team Rocket e il Capopalestra di\l"
	.string "Smeraldopoli sono la stessa persona.\p"
	.string "Una porta tra i mondi è un affare.\n"
	.string "Peccato che qualcuno l'abbia rubata a\l"
	.string "me.\p"
	.string "Morgana mi ha venduto la mia stessa\n"
	.string "merce. E tu mi hai rovinato gli affari\l"
	.string "due volte.\p"
	.string "Chiudiamo i conti. Stavolta non mi\n"
	.string "trattengo.$"

ViridianCity_Gym_Frlg_Text_GiovanniDefeat:
	.string "Ah… Che lotta intensa.\p"
	.string "Hai vinto. Prendi la Medaglia Terra.$"

ViridianCity_Gym_Frlg_Text_ReceivedBadge:
	.string "{PLAYER} ha ricevuto la Medaglia Terra da\n"
	.string "Giovanni!$"

ViridianCity_Gym_Frlg_Text_GiovanniExplainBadge:
	.string "La Medaglia Terra. Con otto Medaglie di\n"
	.string "Kanto, le guardie del Percorso 23 ti\l"
	.string "lasceranno passare.\p"
	.string "E ora ascolta. Il Team Rocket è sciolto.\n"
	.string "Di nuovo.\p"
	.string "Morgana è alla Grotta Celeste, oltre il\n"
	.string "fiume di Celestopoli. Vuole collegare la\l"
	.string "Serratura al Varco vivente.\p"
	.string "Ho detto alla guardia della grotta di\n"
	.string "lasciarti entrare. Non è più affar mio.\p"
	.string "Prendi anche questa. Consideralo… un\n"
	.string "saldo.$"

ViridianCity_Gym_Frlg_Text_GiovanniExplainTM:
	.string "La MT26 contiene Terremoto.\p"
	.string "Scuote il terreno e colpisce tutti i\n"
	.string "Pokémon in campo. Una mossa potente,\l"
	.string "per chi sa controllarla.$"

ViridianCity_Gym_Frlg_Text_GiovanniPostBattle:
	.string "Il Team Rocket non esiste più. Io mi\n"
	.string "ritirerò ad allenarmi, lontano da tutto.\p"
	.string "Morgana ti aspetta alla Grotta Celeste.\p"
	.string "Una porta tra i mondi… forse non doveva\n"
	.string "avere un padrone. Né io, né lei.\p"
	.string "Ora vattene. Ci rivedremo, un giorno.$"


SaffronCity_Dojo_Frlg_Text_HitoshiIntro:
	.string "Hwaah!\p"
	.string "Stai invadendo il nostro Dojo Karate!$"

SaffronCity_Dojo_Frlg_Text_HitoshiDefeat:
	.string "Uff! Mi arrendo!$"

SaffronCity_Dojo_Frlg_Text_HitoshiPostBattle:
	.string "Qui si allenano i lottatori più forti di\n"
	.string "Kanto. E adesso pure quelli venuti dal\p"
	.string "Varco!$"

SaffronCity_Dojo_Frlg_Text_HidekiIntro:
	.string "Dicono che tu sia forte! Fammi vedere!$"

SaffronCity_Dojo_Frlg_Text_HidekiDefeat:
	.string "Arbitro! Punto per te!$"

SaffronCity_Dojo_Frlg_Text_HidekiPostBattle:
	.string "Il nostro Maestro è un vero\n"
	.string "professionista. Preparati a perdere!$"

SaffronCity_Dojo_Frlg_Text_AaronIntro:
	.string "Hiyah! Non ho paura di niente! Spacco\n"
	.string "massi ogni giorno per allenarmi!$"

SaffronCity_Dojo_Frlg_Text_AaronDefeat:
	.string "Ahia! Le mie dita!$"

SaffronCity_Dojo_Frlg_Text_AaronPostBattle:
	.string "L'unica cosa che ci spaventa sono i\n"
	.string "poteri psichici. E la Palestra qui\p"
	.string "accanto ne è piena.$"

SaffronCity_Dojo_Frlg_Text_MikeIntro:
	.string "Hoargh! Togliti le scarpe!$"

SaffronCity_Dojo_Frlg_Text_MikeDefeat:
	.string "Mi arrendo!$"

SaffronCity_Dojo_Frlg_Text_MikePostBattle:
	.string "Aspetta di vedere il Maestro! Io, al\n"
	.string "confronto, sono un pesce piccolo!$"

SaffronCity_Dojo_Frlg_Text_MasterKoichiIntro:
	.string "Hmpf!\p"
	.string "Sono il Maestro di Karate, il capo di\n"
	.string "questo Dojo!\p"
	.string "Un Campione arrivato da un altro mondo?\n"
	.string "Allora niente pietà! Fwaaa!$"

SaffronCity_Dojo_Frlg_Text_MasterKoichiDefeat:
	.string "Hwa! Argh! Battuto!$"

SaffronCity_Dojo_Frlg_Text_MasterKoichiPostBattle:
	.string "Hmpf! La tua forza viene da lontano, ma\n"
	.string "il cuore è quello giusto. Resta ad\p"
	.string "allenarti con noi!$"


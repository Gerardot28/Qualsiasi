FallarborTown_BattleTentLobby_Text_WelcomeToBattleTent:
	.string "Benvenuto alla Tenda Lotta\n"
	.string "di Brunifoglia!\p"
	.string "Sono la tua guida al Torneo KO!$"

FallarborTown_BattleTentLobby_Text_TakeChallenge:
	.string "Allora, vuoi cimentarti nella sfida\n"
	.string "del Torneo KO?$"

FallarborTown_BattleTentLobby_Text_AwaitAnotherChallenge:
	.string "Attendiamo la tua sfida\n"
	.string "in un'altra occasione!$"

FallarborTown_BattleTentLobby_Text_ExplainFallarborTent:
	.string "Alla Tenda Lotta di Brunifoglia\n"
	.string "si disputa il Torneo KO.\p"
	.string "Tutti i partecipanti si presentano\n"
	.string "con una squadra di tre Pokémon.\p"
	.string "I tre Pokémon vanno schierati\n"
	.string "nell'ordine in cui scenderanno in campo.\p"
	.string "Durante la lotta, i Pokémon entrano\n"
	.string "uno alla volta, nell'ordine stabilito.\p"
	.string "Una volta in campo, un Pokémon deve\n"
	.string "restarci finché l'incontro non è deciso.\p"
	.string "Se dopo tre turni l'incontro non è\n"
	.string "ancora deciso, si passa al giudizio.\p"
	.string "Se vuoi interrompere la sfida,\n"
	.string "ricordati di salvare il gioco.\p"
	.string "Se non salvi, non potrai\n"
	.string "proseguire la sfida.\p"
	.string "Se riuscirai nell'impresa di battere\n"
	.string "tre Allenatori di fila,\l"
	.string "riceverai un ottimo premio.$"

FallarborTown_BattleTentLobby_Text_SaveBeforeChallenge:
	.string "Prima di accompagnarti alla Tenda\n"
	.string "Lotta devo salvare. Va bene?$"

@ Unused
